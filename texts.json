  "nexthost.title": { "en": "Next host", "de": "Nächster Host", "fr": "Prochain hôte", "ru": "Следующий хост", "uk": "Наступний хост", "zh-CN": "下一位房主" },
  "nexthost.help": { "en": "Choose who becomes the host when you leave. The game picks the first connected player of its host list; this puts your choice at the top.", "de": "Wähle, wer Host wird, wenn du gehst. Das Spiel nimmt den ersten verbundenen Spieler seiner Hostliste; deine Wahl kommt an deren Anfang.", "fr": "Choisissez qui devient l'hôte quand vous partez. Le jeu prend le premier joueur connecté de sa liste d'hôtes ; votre choix est placé en tête.", "ru": "Выберите, кто станет хостом, когда вы выйдете. Игра берёт первого подключённого игрока из своего списка хостов; ваш выбор ставится в начало списка.", "uk": "Оберіть, хто стане хостом, коли ви вийдете. Гра бере першого підключеного гравця зі свого списку хостів; ваш вибір ставиться на початок списку.", "zh-CN": "选择你离开后由谁成为房主。游戏会选择其房主列表中第一位已连接的玩家；此功能把你的选择放到列表最前面。" },
  "nexthost.automatic": { "en": "Automatic (the game decides)", "de": "Automatisch (das Spiel entscheidet)", "fr": "Automatique (le jeu décide)", "ru": "Автоматически (решает игра)", "uk": "Автоматично (вирішує гра)", "zh-CN": "自动（由游戏决定）" },
  "nexthost.auto": { "en": "Automatic: the game decides.", "de": "Automatisch: das Spiel entscheidet.", "fr": "Automatique : le jeu décide.", "ru": "Автоматически: решает игра.", "uk": "Автоматично: вирішує гра.", "zh-CN": "自动：由游戏决定。" },
  "nexthost.done": { "en": "Done. If you leave now, this player becomes the host.", "de": "Erledigt. Wenn du jetzt gehst, wird dieser Spieler Host.", "fr": "C'est fait. Si vous partez maintenant, ce joueur devient l'hôte.", "ru": "Готово. Если вы сейчас выйдете, хостом станет этот игрок.", "uk": "Готово. Якщо ви зараз вийдете, хостом стане цей гравець.", "zh-CN": "完成。如果你现在离开，该玩家将成为房主。" },
  "nexthost.saved": { "en": "Saved; applied as soon as the lobby allows it.", "de": "Gespeichert; wird angewendet, sobald die Lobby es erlaubt.", "fr": "Enregistré ; appliqué dès que le salon le permet.", "ru": "Сохранено; применится, как только лобби позволит.", "uk": "Збережено; застосується, щойно лобі дозволить.", "zh-CN": "已保存；大厅允许后立即生效。" },
  "nexthost.left": { "en": "That player left - back to automatic.", "de": "Dieser Spieler ist gegangen – wieder automatisch.", "fr": "Ce joueur est parti – retour en automatique.", "ru": "Этот игрок вышел — снова автоматически.", "uk": "Цей гравець вийшов — знову автоматично.", "zh-CN": "该玩家已离开 — 恢复为自动。" },
